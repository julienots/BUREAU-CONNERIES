class_name RenderFx
## Realistic rendering pipeline, one place for every graphics tier.
##
##  low    : mobile renderer, baked-looking ambient, no screen-space effects (unchanged budget)
##  medium : SSAO, glow, reflection probes, PBR maps, LCD/glass shaders
##  high   : + SSR, SSIL, volumetric fog light shafts, auto exposure, far DOF, SMAA, post FX
##  ultra  : + SDFGI real-time global illumination, soft PCSS shadows on the sun and on the
##           ceiling spots, 4-split sun shadows, TAA, dust motes in the sun beams
##
## Everything is generated by code so it also applies to the menu and the test scenes.

const POST_SHADER := "res://assets/shaders/post_fx.gdshader"


static func rank(q: String) -> int:
	return {"low": 0, "medium": 1, "high": 2, "ultra": 3}.get(q, 2)


static func at_least(q: String, wanted: String) -> bool:
	return rank(q) >= rank(wanted)


# ------------------------------------------------------------------ environment
static func make_environment(q: String) -> Environment:
	var env := Environment.new()
	var sky := Sky.new()
	if at_least(q, "high"):
		var ps := PhysicalSkyMaterial.new()
		ps.rayleigh_coefficient = 2.2
		ps.mie_coefficient = 0.006
		ps.mie_eccentricity = 0.78
		ps.turbidity = 8.0
		ps.sun_disk_scale = 1.2
		ps.ground_color = Color(0.32, 0.31, 0.3)
		ps.energy_multiplier = 1.0
		sky.sky_material = ps
		sky.radiance_size = Sky.RADIANCE_SIZE_256
	else:
		var sm := ProceduralSkyMaterial.new()
		sm.sky_top_color = Color(0.35, 0.55, 0.85)
		sm.sky_horizon_color = Color(0.75, 0.82, 0.9)
		sm.ground_horizon_color = Color(0.6, 0.62, 0.65)
		sm.ground_bottom_color = Color(0.3, 0.3, 0.32)
		sky.sky_material = sm
	env.sky = sky
	env.background_mode = Environment.BG_SKY
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
	env.ambient_light_sky_contribution = 0.8
	env.tonemap_mode = Environment.TONE_MAPPER_AGX
	env.tonemap_white = 6.0
	env.adjustment_enabled = true
	match q:
		"low":
			env.ambient_light_energy = 0.85
			env.adjustment_saturation = 1.12
			env.adjustment_contrast = 1.05
		"medium":
			env.ambient_light_energy = 0.6
			env.adjustment_saturation = 1.08
			env.adjustment_contrast = 1.05
		_:
			env.ambient_light_energy = 0.35 if q == "ultra" else 0.45
			env.ambient_light_sky_contribution = 0.6
			env.adjustment_saturation = 1.06
			env.adjustment_contrast = 1.04
			env.tonemap_exposure = 1.0
			env.set("tonemap_agx_contrast", 1.15)
	var ssao_ok: bool = Settings.get_v("ssao")
	if at_least(q, "medium") and ssao_ok:
		env.ssao_enabled = true
		env.ssao_radius = 1.0 if at_least(q, "high") else 0.8
		env.ssao_intensity = 2.2 if at_least(q, "high") else 1.6
		env.ssao_power = 1.6
		env.ssao_detail = 0.6
		env.ssao_horizon = 0.06
		env.ssao_sharpness = 0.98
		env.ssao_light_affect = 0.08
		env.ssao_ao_channel_affect = 0.35
	if at_least(q, "high"):
		env.ssr_enabled = true
		env.ssr_max_steps = 96 if q == "ultra" else 56
		env.ssr_fade_in = 0.12
		env.ssr_fade_out = 2.5
		env.ssr_depth_tolerance = 0.25
		if ssao_ok:
			env.ssil_enabled = true
			env.ssil_radius = 3.5
			env.ssil_intensity = 0.9 if q == "ultra" else 1.2
			env.ssil_sharpness = 0.98
			env.ssil_normal_rejection = 1.0
		env.volumetric_fog_enabled = not Settings.get_v("reduce_effects")
		env.volumetric_fog_density = 0.0075
		env.volumetric_fog_albedo = Color(0.92, 0.92, 0.95)
		env.volumetric_fog_anisotropy = 0.65
		env.volumetric_fog_length = 48.0
		env.volumetric_fog_detail_spread = 2.0
		env.volumetric_fog_gi_inject = 0.6
		env.volumetric_fog_ambient_inject = 0.08
		env.volumetric_fog_sky_affect = 0.0
		env.volumetric_fog_temporal_reprojection_enabled = true
		env.volumetric_fog_temporal_reprojection_amount = 0.92
	if q == "ultra":
		env.sdfgi_enabled = true
		env.sdfgi_use_occlusion = true
		env.sdfgi_read_sky_light = true
		env.sdfgi_bounce_feedback = 0.55
		env.sdfgi_cascades = 4
		env.sdfgi_min_cell_size = 0.12
		env.sdfgi_y_scale = Environment.SDFGI_Y_SCALE_50_PERCENT
		env.sdfgi_energy = 1.1
		env.sdfgi_normal_bias = 1.1
		env.sdfgi_probe_bias = 1.1
	if q != "low" and Settings.get_v("glow"):
		env.glow_enabled = true
		env.glow_normalized = false
		env.glow_intensity = 0.55 if at_least(q, "high") else 0.4
		env.glow_strength = 1.0
		env.glow_bloom = 0.0 if at_least(q, "high") else 0.05
		env.glow_hdr_threshold = 1.5 if at_least(q, "high") else 1.2
		env.glow_hdr_scale = 2.0
		env.glow_hdr_luminance_cap = 6.0   # a sun glint on glass must not flood the screen
		env.glow_blend_mode = Environment.GLOW_BLEND_MODE_SOFTLIGHT if q == "medium" else Environment.GLOW_BLEND_MODE_ADDITIVE
		if at_least(q, "high"):
			env.glow_intensity = 0.22
			for i in 7:
				env.set("glow_levels/%d" % (i + 1), [0.0, 0.6, 1.0, 0.8, 0.7, 0.5, 0.3][i])
			var dirt := Mats.tex("lens_dirt")
			if dirt and not Settings.get_v("reduce_effects"):
				env.glow_map = dirt
				env.glow_map_strength = 0.22
	return env


static func make_camera_attributes(q: String) -> CameraAttributes:
	var ca := CameraAttributesPractical.new()
	if at_least(q, "high"):
		# eye adaptation: dark archives look dark at first, sunny windows bloom
		ca.auto_exposure_enabled = true
		ca.auto_exposure_scale = 0.24
		ca.auto_exposure_speed = 0.9
		ca.auto_exposure_min_sensitivity = 100.0
		ca.auto_exposure_max_sensitivity = 900.0
		if not Settings.get_v("reduce_effects"):
			ca.dof_blur_far_enabled = true
			ca.dof_blur_far_distance = 22.0
			ca.dof_blur_far_transition = 18.0
			ca.dof_blur_amount = 0.045
	return ca


static func setup_sun(sun: DirectionalLight3D, q: String) -> void:
	sun.light_color = Color(1.0, 0.92, 0.8)
	sun.light_energy = 1.5
	sun.shadow_enabled = Settings.get_v("shadows") and q != "low"
	sun.directional_shadow_max_distance = 45.0
	sun.shadow_blur = 1.5
	match q:
		"low":
			sun.directional_shadow_mode = DirectionalLight3D.SHADOW_ORTHOGONAL
		"medium":
			sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_2_SPLITS
		_:
			sun.light_energy = 3.2
			sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_4_SPLITS
			sun.directional_shadow_split_1 = 0.06
			sun.directional_shadow_split_2 = 0.18
			sun.directional_shadow_split_3 = 0.45
			sun.directional_shadow_blend_splits = true
			sun.shadow_bias = 0.03
			sun.shadow_normal_bias = 1.2
			sun.shadow_blur = 1.0
			sun.light_volumetric_fog_energy = 2.2
			sun.light_angular_distance = 0.6 if q == "ultra" else 0.0
			sun.light_specular = 1.0


## Ceiling light. Spots aimed down light the floor like real recessed fittings and,
## on ultra, cast soft shadows under desks and chairs.
static func make_ceiling_light(q: String, range_m: float, energy: float, shadow: bool) -> Light3D:
	if at_least(q, "high"):
		var s := SpotLight3D.new()
		s.rotation_degrees = Vector3(-90, 0, 0)
		s.spot_angle = 72.0
		s.spot_angle_attenuation = 0.6
		s.spot_range = range_m * 1.15
		s.spot_attenuation = 0.9
		s.light_energy = energy * 2.4
		s.light_size = 0.5
		s.light_specular = 0.3
		s.light_volumetric_fog_energy = 0.35
		s.shadow_enabled = shadow
		s.shadow_blur = 1.5
		s.shadow_bias = 0.04
		s.shadow_normal_bias = 1.5
		s.distance_fade_enabled = true
		s.distance_fade_begin = 28.0
		s.distance_fade_length = 8.0
		return s
	var l := OmniLight3D.new()
	l.omni_range = range_m
	l.omni_attenuation = 0.9
	l.light_energy = energy
	l.shadow_enabled = false
	return l


## One box-projected interior probe per room: real reflections on floors, desks, screens.
static func add_reflection_probes(parent: Node3D, rooms: Dictionary, height: float, q: String) -> void:
	if not at_least(q, "medium"):
		return
	for id in rooms:
		var r: Rect2 = rooms[id].rect
		var p := ReflectionProbe.new()
		p.name = "Probe_" + id
		p.size = Vector3(r.size.x, height, r.size.y)
		p.position = Vector3(r.get_center().x, height * 0.5, r.get_center().y)
		p.box_projection = true
		p.interior = true
		p.update_mode = ReflectionProbe.UPDATE_ONCE
		p.intensity = 1.0
		p.blend_distance = 0.6
		p.enable_shadows = at_least(q, "high")
		p.max_distance = maxf(r.size.x, r.size.y) * 1.5
		p.ambient_mode = ReflectionProbe.AMBIENT_DISABLED
		p.origin_offset = Vector3(0, -height * 0.5 + 1.4, 0)
		parent.add_child(p)


## Floating dust caught in the window light (ultra only, cheap GPU particles).
static func add_dust(parent: Node3D, area: AABB, q: String) -> void:
	if q != "ultra" or Settings.get_v("reduce_effects"):
		return
	var gp := GPUParticles3D.new()
	gp.name = "Dust"
	gp.amount = 900
	gp.lifetime = 14.0
	gp.preprocess = 14.0
	gp.visibility_aabb = AABB(-area.size * 0.5, area.size)
	gp.position = area.get_center()
	var pm := ParticleProcessMaterial.new()
	pm.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_BOX
	pm.emission_box_extents = area.size * 0.5
	pm.gravity = Vector3(0, -0.004, 0)
	pm.direction = Vector3(1, 0.2, 0.3)
	pm.spread = 180.0
	pm.initial_velocity_min = 0.005
	pm.initial_velocity_max = 0.03
	pm.turbulence_enabled = true
	pm.turbulence_noise_strength = 0.6
	pm.turbulence_noise_scale = 3.0
	pm.turbulence_influence_min = 0.02
	pm.turbulence_influence_max = 0.06
	pm.scale_min = 0.4
	pm.scale_max = 1.0
	var alpha := Curve.new()
	alpha.add_point(Vector2(0, 0))
	alpha.add_point(Vector2(0.2, 1))
	alpha.add_point(Vector2(0.8, 1))
	alpha.add_point(Vector2(1, 0))
	var ac := CurveTexture.new()
	ac.curve = alpha
	pm.alpha_curve = ac
	gp.process_material = pm
	var quad := QuadMesh.new()
	quad.size = Vector2(0.006, 0.006)
	var m := StandardMaterial3D.new()
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	m.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
	m.vertex_color_use_as_albedo = true
	m.albedo_color = Color(1.0, 0.95, 0.85, 0.5)
	m.shading_mode = BaseMaterial3D.SHADING_MODE_PER_VERTEX
	m.disable_receive_shadows = false
	quad.material = m
	gp.draw_pass_1 = quad
	gp.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	parent.add_child(gp)


# ------------------------------------------------------------------ screen
static func post_fx_enabled(q: String) -> bool:
	return at_least(q, "high") and Settings.get_v("post_fx")


## Full-screen cinematic pass, drawn under every HUD layer (layer -1).
static func add_post_fx(parent: Node, q: String) -> CanvasLayer:
	if not post_fx_enabled(q) or not ResourceLoader.exists(POST_SHADER):
		return null
	var layer := CanvasLayer.new()
	layer.name = "PostFx"
	layer.layer = -1
	var rect := ColorRect.new()
	rect.set_anchors_preset(Control.PRESET_FULL_RECT)
	rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var sm := ShaderMaterial.new()
	sm.shader = load(POST_SHADER)
	sm.set_shader_parameter("lens_dirt", Mats.tex("lens_dirt"))
	if Settings.get_v("reduce_effects"):
		sm.set_shader_parameter("aberration", 0.0)
		sm.set_shader_parameter("grain", 0.0)
		sm.set_shader_parameter("distortion", 0.0)
		sm.set_shader_parameter("dirt_strength", 0.0)
	if q != "ultra":
		sm.set_shader_parameter("grain", 0.018)
	rect.material = sm
	layer.add_child(rect)
	parent.add_child(layer)
	return layer


static func apply_viewport(vp: Viewport, q: String) -> void:
	if vp == null:
		return
	vp.use_debanding = q != "low"
	vp.anisotropic_filtering_level = Viewport.ANISOTROPY_16X if at_least(q, "high") else Viewport.ANISOTROPY_4X
	match q:
		"ultra":
			vp.use_taa = true
			vp.msaa_3d = Viewport.MSAA_DISABLED
			vp.screen_space_aa = Viewport.SCREEN_SPACE_AA_DISABLED
			vp.texture_mipmap_bias = -0.5
		"high":
			vp.use_taa = false
			vp.msaa_3d = Viewport.MSAA_DISABLED
			vp.screen_space_aa = Viewport.SCREEN_SPACE_AA_SMAA
		_:
			vp.use_taa = false
			vp.msaa_3d = Viewport.MSAA_2X
			vp.screen_space_aa = Viewport.SCREEN_SPACE_AA_DISABLED
	if vp.scaling_3d_scale < 0.99 and at_least(q, "high"):
		vp.scaling_3d_mode = Viewport.SCALING_3D_MODE_FSR2
	else:
		vp.scaling_3d_mode = Viewport.SCALING_3D_MODE_BILINEAR
