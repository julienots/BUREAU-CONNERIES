class_name Barks
extends RefCounted
## Contextual line picker from data/dialogue.json templates with slot filling
## ({name}, {rumor}, {desc}...) and anti-repetition. An optional local LLM can pre-fill
## a pool of extra lines (see LlmProvider); the template system always works without it.

var _recent: Dictionary = {}       # category -> Array[int] recently used indexes
var _extra: Dictionary = {}        # category -> Array[String] generated by the optional LLM
var rng := RandomNumberGenerator.new()


func pick(category: String, slots := {}) -> String:
	var pool: Array = Data.line(category).duplicate()
	var extra: Array = _extra.get(category, [])
	if not extra.is_empty() and rng.randf() < 0.35:
		var line: String = extra.pop_back()
		return _fill(line, slots)
	var recent: Array = _recent.get(category, [])
	var choices: Array[int] = []
	for i in pool.size():
		if not i in recent:
			choices.append(i)
	if choices.is_empty():
		recent.clear()
		for i in pool.size():
			choices.append(i)
	var idx: int = choices[rng.randi() % choices.size()]
	recent.append(idx)
	while recent.size() > maxi(1, pool.size() / 2):
		recent.pop_front()
	_recent[category] = recent
	return _fill(String(pool[idx]), slots)


func _fill(line: String, slots: Dictionary) -> String:
	for k in slots:
		line = line.replace("{" + k + "}", str(slots[k]))
	return line


func add_generated(category: String, line: String) -> void:
	if line.strip_edges() == "" or line.length() > 120:
		return
	if not _extra.has(category):
		_extra[category] = []
	if _extra[category].size() < 12:
		_extra[category].append(line.strip_edges())


func generated_count(category: String) -> int:
	return _extra.get(category, []).size()
